# Public site URL (used for metadata, sitemap, Open Graph).
# Either set a real value or leave the variable out entirely — a blank value
# falls back to Vercel's host, then to site.url in src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://quadilateral.org

# Optional: forward contact form submissions to a webhook (Slack, Zapier, n8n, make.com)
CONTACT_WEBHOOK_URL=

# Optional: email delivery (e.g. Resend) — wire up in src/app/api/contact/route.ts
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@quadilateral.org
